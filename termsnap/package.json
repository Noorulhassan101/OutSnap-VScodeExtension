{
  "name": "outsnap",
  "displayName": "OutSnap",
  "description": "Automatic Terminal Screenshot Capture — On Your Terms",
  "version": "1.1.0",
  "publisher": "MNoor-Ul-Hassan",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/MNoor-Ul-Hassan/TermSnap"
  },
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "commands": [
      {
        "command": "outsnap.enableCapture",
        "title": "OutSnap: Enable Capture",
        "category": "OutSnap"
      },
      {
        "command": "outsnap.disableCapture",
        "title": "OutSnap: Disable Capture",
        "category": "OutSnap"
      },
      {
        "command": "outsnap.toggleCapture",
        "title": "OutSnap: Toggle Capture",
        "category": "OutSnap"
      },
      {
        "command": "outsnap.openScreenshotsFolder",
        "title": "OutSnap: Open Screenshots Folder",
        "category": "OutSnap"
      },
      {
        "command": "outsnap.exportToWord",
        "title": "OutSnap: Export to Word Document",
        "category": "OutSnap"
      },
      {
        "command": "outsnap.clearAllScreenshots",
        "title": "OutSnap: Clear All Screenshots",
        "category": "OutSnap"
      },
      {
        "command": "outsnap.openSettings",
        "title": "OutSnap: Open Settings",
        "category": "OutSnap"
      },
      {
        "command": "outsnap.showCaptureLog",
        "title": "OutSnap: Show Capture Log",
        "category": "OutSnap"
      },
      {
        "command": "outsnap.setCropPercentage",
        "title": "OutSnap: Set Crop Percentage",
        "category": "OutSnap"
      },
      {
        "command": "outsnap.setLabDocument",
        "title": "OutSnap: Set Lab Document",
        "category": "OutSnap"
      },
      {
        "command": "outsnap.setCurrentTask",
        "title": "OutSnap: Set Current Task",
        "category": "OutSnap"
      },
      {
        "command": "outsnap.nextTask",
        "title": "OutSnap: Next Task",
        "category": "OutSnap"
      },
      {
        "command": "outsnap.insertScreenshots",
        "title": "OutSnap: Insert Screenshots into Lab Document",
        "category": "OutSnap"
      }
    ],
    "configuration": {
      "title": "OutSnap",
      "properties": {
        "outsnap.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Master on/off toggle for OutSnap capture."
        },
        "outsnap.sessionOnly": {
          "type": "boolean",
          "default": true,
          "description": "Reset OutSnap to OFF when VSCode closes."
        },
        "outsnap.storageMode": {
          "type": "string",
          "enum": [
            "workspace",
            "global",
            "custom"
          ],
          "default": "workspace",
          "description": "Where to save screenshots: workspace (project folder), global (standard folder), or custom (specified path)."
        },
        "outsnap.folderName": {
          "type": "string",
          "default": ".outsnap",
          "description": "Subfolder name created inside the workspace root (only for 'workspace' mode)."
        },
        "outsnap.autoGitignore": {
          "type": "boolean",
          "default": true,
          "description": "Automatically add the screenshot folder to .gitignore on first capture in a git repo."
        },
        "outsnap.fallbackPath": {
          "type": "string",
          "default": "~/outsnap/",
          "description": "Used only when no workspace folder is open."
        },
        "outsnap.customPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to use when storageMode is 'custom'."
        },
        "outsnap.renderDelay": {
          "type": "number",
          "default": 350,
          "minimum": 100,
          "maximum": 1000,
          "description": "Milliseconds to wait before capturing the screenshot after command ends."
        },
        "outsnap.confirmBeforeCapture": {
          "type": "boolean",
          "default": false,
          "description": "Show a toast before each capture to confirm saving."
        },
        "outsnap.excludeCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "ls",
            "cd",
            "clear",
            "cls",
            "pwd"
          ],
          "description": "Commands to ignore (no screenshots taken)."
        },
        "outsnap.captureOnlySuccessful": {
          "type": "boolean",
          "default": true,
          "description": "Only capture screenshots for commands that exit successfully (exit code 0)."
        },
        "outsnap.imageFormat": {
          "type": "string",
          "enum": [
            "png",
            "jpg"
          ],
          "default": "png",
          "description": "Output format for the screenshot: png or jpg."
        },
        "outsnap.autoExportDocx": {
          "type": "boolean",
          "default": false,
          "description": "Auto-generate .docx at the end of each session."
        },
        "outsnap.statusBarPosition": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "default": "left",
          "description": "Status bar button position: left or right."
        },
        "outsnap.showCaptureToast": {
          "type": "boolean",
          "default": true,
          "description": "Show toast notification after each capture."
        },
        "outsnap.cropToTerminal": {
          "type": "boolean",
          "default": true,
          "description": "Experimental: Crop the bottom portion of the screenshot to simulate capturing only the terminal."
        },
        "outsnap.terminalCropPercentage": {
          "type": "number",
          "default": 45,
          "minimum": 10,
          "maximum": 100,
          "description": "The percentage of the bottom screen to crop when cropToTerminal is enabled."
        },
        "outsnap.labMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable lab report / assignment mode."
        },
        "outsnap.labDocument": {
          "type": "string",
          "default": "",
          "description": "Path to the lab document. Auto-detected if empty."
        },
        "outsnap.captionStyle": {
          "type": "string",
          "enum": [
            "timestamp",
            "command",
            "both",
            "none"
          ],
          "default": "none",
          "description": "What to show in the caption below each screenshot."
        },
        "outsnap.imageWidth": {
          "type": "number",
          "default": 6,
          "minimum": 1,
          "maximum": 8,
          "description": "Inserted image width in inches (1–8)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "dependencies": {
    "@types/jszip": "^3.4.0",
    "docx": "^8.5.0",
    "image-size": "^1.2.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "node-screenshots": "^0.2.8"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "^1.93.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3"
  }
}
